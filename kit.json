    {"id": "why", "type": "bento", "columns": 3, "cells": [
      {"span": 2, "icon": "lock", "kicker": {"en": "Offline", "es": "Offline"}, "title": {"en": "Local only", "es": "Solo local"},
       "text": {"en": "No AI calls, no network, no telemetry at runtime. A rule engine, not an AI detector.", "es": "Sin llamadas a IA, sin red, sin telemetría. Un motor de reglas, no un detector de IA."}},
      {"icon": "target", "kicker": {"en": "Output", "es": "Salida"}, "title": {"en": "Deterministic", "es": "Determinista"},
       "text": {"en": "Same input, same output. Fixes are idempotent.", "es": "Misma entrada, misma salida. Las correcciones son idempotentes."}},
      {"icon": "shield", "kicker": {"en": "Writes", "es": "Escritura"}, "title": {"en": "Safe by default", "es": "Seguro por defecto"},
       "text": {"en": "check never writes. Fixes keep encoding, BOM and line endings.", "es": "check nunca escribe. Las correcciones conservan codificación, BOM y saltos."}},
      {"icon": "repeat", "kicker": {"en": "Hooks", "es": "Hooks"}, "title": {"en": "Respectful", "es": "Respetuoso"},
       "text": {"en": "Existing hooks keep running. Uninstall restores the original bytes.", "es": "Tus hooks siguen corriendo. Desinstalar restaura los bytes originales."}},
      {"icon": "users", "kicker": {"en": "Commits", "es": "Commits"}, "title": {"en": "Keeps humans", "es": "Respeta personas"},
       "text": {"en": "Drops AI Co-Authored-By lines and keeps human co-authors.", "es": "Quita los Co-Authored-By de IA y deja a los coautores humanos."}}
    ]},
